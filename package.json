{
  "name": "dungeon-curio-merchant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/build-map-tile-assets.mjs && node scripts/build-actor-assets.mjs",
    "assets:inspect": "node scripts/inspect-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "edit": "vite --open /review.html",
    "prebuild": "npm run assets",
    "build": "tsc --noEmit && vite build",
    "pretest": "npm run assets",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/pngjs": "^6.0.5",
    "fast-xml-parser": "^5.11.0",
    "fflate": "^0.8.3",
    "pngjs": "^7.0.0",
    "typescript": "5.9.2",
    "vite": "6.4.3",
    "vitest": "3.2.4"
  }
}
